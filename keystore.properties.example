# Copy this file to `keystore.properties` (gitignored) at the repo root and fill in real values
# to produce a signed release build. See docs/DEPLOYMENT.md for how to generate the keystore.
#
# Alternatively, set the SPORTCASTER_KEYSTORE_PATH / SPORTCASTER_KEYSTORE_PASSWORD /
# SPORTCASTER_KEY_ALIAS / SPORTCASTER_KEY_PASSWORD environment variables instead (useful for CI),
# which `app/build.gradle.kts` falls back to if this file isn't present.

storeFile=/absolute/path/to/upload-keystore.jks
storePassword=changeit
keyAlias=sportcaster-upload
keyPassword=changeit
